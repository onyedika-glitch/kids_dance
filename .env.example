# Supabase Postgres (Project Settings → Database → Connection string → Transaction pooler).
# Either DATABASE_URL or the DB_* variables.
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
# DATABASE_URL=postgres://postgres.your-project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Booking notification email via Resend (https://resend.com/api-keys).
# MAIL_FROM must be on a domain verified in Resend (e.g. noreply@devomogo.tech);
# the default onboarding@resend.dev can only deliver to the Resend account owner.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM="EYS-Kids Dance Academy <noreply@devomogo.tech>"
NUXT_NOTIFY_EMAIL=omogopeter@devomogo.tech

# Optional: map tiles. Default is Esri's label-free light gray basemap (no Japanese labels).
# For street names in English use a keyed provider, e.g. MapTiler / Mapbox with English labels:
# NUXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NUXT_PUBLIC_MAP_ATTRIBUTION=...
# NUXT_PUBLIC_MAP_MAX_NATIVE_ZOOM=19

NUXT_TELEMETRY_DISABLED=1
