# Supabase Postgres (Project Settings → Database → Connection string → Transaction pooler).
# Either DATABASE_URL or the DB_* variables. Schema: supabase/migrations/*.sql, content: supabase/seed.sql.
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
# DATABASE_URL=postgres://postgres.your-project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Contact-form emails via Resend (https://resend.com/api-keys). MAIL_FROM must be on a domain verified in Resend.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM="Tiny Explorers Hub <hello@your-domain.com>"
NUXT_NOTIFY_EMAIL=franklinomogo67@gmail.com

# Paystack (https://dashboard.paystack.com/#/settings/developers). Use the sk_test_ key while testing.
# Webhook URL to set in Paystack: https://<your-domain>/api/paystack/webhook
NUXT_PAYSTACK_SECRET_KEY=

# Random secret used to hash anonymous like ids. Generate one: openssl rand -hex 32
NUXT_VISITOR_SALT=

# Public URL of the site (used for Paystack's return URL, share links and SEO)
NUXT_PUBLIC_SITE_URL=http://localhost:3100

NUXT_TELEMETRY_DISABLED=1
